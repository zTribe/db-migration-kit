{
  "name": "@ztribe/db-migration-kit",
  "version": "0.2.1",
  "description": "Shared PostgreSQL migration runner, checksum auditor, local CLI and runtime security catalog checks for zTribe services.",
  "type": "module",
  "exports": {
    "./verify-migration-upgrade": "./src/verify-migration-upgrade.js",
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "import": "./src/testing.js"
    }
  },
  "bin": {
    "db-migrate-kit": "./bin/db-migrate-kit.js",
    "db-migrate-kit-test": "./bin/test-local.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pg": ">=8.12.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/*.integration.test.js"
  },
  "license": "MIT",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zTribe/db-migration-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
